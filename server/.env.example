# ============================================================
# MSN ACADEMY INTERNSHIP PORTAL - SERVER
# Copy to .env and fill in before running `npm run dev`.
# ============================================================

PORT=5000

# MongoDB (one database for the whole portal)
MONGO_URI=mongodb://127.0.0.1:27017/msn_academy

# JWT signing secret - required
JWT_SECRET=change-this-to-a-long-random-string

# Comma separated list of allowed client origins
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173

# Used to build the password reset link
FRONTEND_URL=http://localhost:5173

# Optional: SMTP for password reset email.
# Leave unset and the reset link is returned to the UI instead.
# EMAIL_SERVICE=gmail
# EMAIL_USER=
# EMAIL_PASS=

# Optional: overrides the default password used by `npm run seed:admin`
# SUPER_ADMIN_PASSWORD=
